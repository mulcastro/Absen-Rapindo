# Konfigurasi PUBLIK frontend. Semua VITE_ masuk bundle browser.
# Jangan menaruh secret server, PIN, model threshold, atau kunci enkripsi di sini.
VITE_API_BASE_URL=/api
VITE_DATA_SOURCE=api
# Untuk dev mock gunakan file lokal .env.development.local sesuai instruksi implementasi.
# Produksi WAJIB menolak mock; validation build belum ada sampai scaffolding dibuat.
