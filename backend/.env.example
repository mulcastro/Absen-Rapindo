APP_ENV=development
DATABASE_URL=postgresql+psycopg://absensi:change-me@127.0.0.1:5432/absensi
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://127.0.0.1:5173
# Wajib di produksi berdasarkan hasil uji ukuran burst; kosong berarti development tanpa batas global.
MAX_REQUEST_BYTES=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Opsional: Base32 minimal 160 bit. Jika kosong bootstrap membuat secret acak dan menampilkannya sekali.
ADMIN_BOOTSTRAP_TOTP_SECRET=
BIOMETRICS_MODE=disabled
# Gunakan approved setelah G1/G2 disetujui. Nilai wajib berasal hasil kalibrasi yang dibekukan.
CANDIDATE_DETECTION_THRESHOLD=
CANDIDATE_PAD_THRESHOLD=
CANDIDATE_MATCH_THRESHOLD=
CANDIDATE_FRONT_YAW_MAX=
CANDIDATE_TURN_YAW_MIN=
CANDIDATE_LEFT_YAW_SIGN=
CANDIDATE_MIN_LIVE_FRAMES=
ENCRYPTION_KEY_BASE64=
ENCRYPTION_KEY_ID=unset
CONSENT_VERSION=2026-11-10-v1
CONSENT_TEXT="Saya menyetujui LPK Rapindo memproses data wajah saya untuk pendaftaran identitas dan verifikasi kehadiran pelatihan. Data wajah hanya digunakan untuk tujuan tersebut dan dilindungi dengan penyimpanan terenkripsi. Bukti foto verifikasi disimpan paling lama 90 hari, kemudian dihapus sesuai kebijakan retensi. Template biometrik digunakan selama akun peserta masih diperlukan untuk kegiatan pelatihan. Saya dapat menghubungi pengelola LPK Rapindo untuk meminta informasi mengenai pemrosesan atau penghapusan data setelah kebutuhan pelatihan berakhir."
CONSENT_IS_DRAFT=false
ATTEMPT_COOLDOWN_SECONDS=15
ATTEMPT_CAP_PER_SESSION=5
EVIDENCE_RETENTION_DAYS=90
